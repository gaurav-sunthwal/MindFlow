{
  "expo": {
    "name": "taskflow",
    "slug": "taskflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "taskflow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gauravsunthwal.taskflow"
    },
    "android": {
      "package": "com.gauravsunthwal.taskflow",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow MindFlow to access your camera to scan and digitize documents."
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "TaskWidget",
              "displayName": "Pending Tasks",
              "description": "Quick view of your upcoming tasks",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            },
            {
              "name": "DocWidget",
              "displayName": "Document Vault",
              "description": "Access your recent documents",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            },
            {
              "name": "EventWidget",
              "displayName": "Upcoming Events",
              "description": "See what's next on your calendar",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            },
            {
              "name": "NoteWidget",
              "displayName": "Quick Notes",
              "description": "View and access your notes",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TaskWidget",
              "label": "Pending Tasks",
              "description": "Quick view of your upcoming tasks",
              "minWidth": "100dp",
              "minHeight": "100dp",
              "targetSize": "flexible"
            },
            {
              "name": "DocWidget",
              "label": "Document Vault",
              "description": "Access your recent documents",
              "minWidth": "100dp",
              "minHeight": "100dp",
              "targetSize": "flexible"
            },
            {
              "name": "EventWidget",
              "label": "Upcoming Events",
              "description": "See what's next on your calendar",
              "minWidth": "100dp",
              "minHeight": "100dp",
              "targetSize": "flexible"
            },
            {
              "name": "NoteWidget",
              "label": "Quick Notes",
              "description": "View and access your notes",
              "minWidth": "100dp",
              "minHeight": "100dp",
              "targetSize": "flexible"
            }
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "772ba5db-8724-4032-b1a6-8a5636f9cef8"
      }
    },
    "owner": "gaurav_sunthwal"
  }
}
